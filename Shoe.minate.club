<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>YoSidhu Shoes | Premium Footwear</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    *{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif}
    body{background:#f8f9fb;color:#222}
    header{background:#000;color:#fff;padding:16px 24px;display:flex;justify-content:space-between;align-items:center}
    header h1{font-size:24px}
    nav a{color:#fff;margin-left:20px;text-decoration:none;font-weight:500}.hero{display:grid;grid-template-columns:1fr 1fr;gap:24px;padding:60px 24px;max-width:1100px;margin:auto;align-items:center}
.hero h2{font-size:42px;margin-bottom:12px}
.hero p{font-size:16px;margin-bottom:20px;color:#555}
.btn{display:inline-block;background:#000;color:#fff;padding:12px 22px;border-radius:10px;text-decoration:none;font-weight:600}
.hero img{width:100%;border-radius:20px;box-shadow:0 10px 30px rgba(0,0,0,0.15)}

.section{max-width:1100px;margin:60px auto;padding:0 24px}
.section h3{text-align:center;font-size:32px;margin-bottom:30px}

.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.card{background:#fff;border-radius:16px;box-shadow:0 6px 18px rgba(0,0,0,0.08);padding:16px;text-align:center}
.card img{width:100%;border-radius:12px;margin-bottom:10px}
.price{font-weight:700;margin:6px 0}

.about, .contact{background:#fff;border-radius:20px;padding:30px;box-shadow:0 6px 18px rgba(0,0,0,0.08)}

footer{text-align:center;padding:20px;background:#000;color:#fff;margin-top:60px}

@media(max-width:800px){.hero{grid-template-columns:1fr;text-align:center}}

  </style>
</head>
<body><header>
  <h1>YoSidhu Shoes</h1>
  <nav>
    <a href="#home">Home</a>
    <a href="#products">Products</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>
</header><section class="hero" id="home">
  <div>
    <h2>Premium Shoes For Every Step</h2>
    <p>Trendy, comfortable and affordable footwear for daily wear, sports and style.</p>
    <a href="#products" class="btn">Shop Now</a>
  </div>
  <img src="https://images.unsplash.com/photo-1528701800489-20be6c8c7c15?q=80&w=1200" alt="Shoes">
</section><section class="section" id="products">
  <h3>Our Collection</h3>
  <div class="products">
    <div class="card">
      <img src="https://images.unsplash.com/photo-1528701800489-20be6c8c7c15?q=80&w=800" />
      <h4>Running Shoes</h4>
      <p class="price">₹1,999</p>
      <a class="btn" href="#contact">Order Now</a>
    </div>
    <div class="card">
      <img src="https://images.unsplash.com/photo-1525966222134-fcfa99b8ae77?q=80&w=800" />
      <h4>Casual Sneakers</h4>
      <p class="price">₹2,499</p>
      <a class="btn" href="#contact">Order Now</a>
    </div>
    <div class="card">
      <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=800" />
      <h4>Sports Shoes</h4>
      <p class="price">₹2,999</p>
      <a class="btn" href="#contact">Order Now</a>
    </div>
  </div>
</section><section class="section" id="about">
  <div class="about">
    <h3>About Us</h3>
    <p>YoSidhu Shoes is your local trusted shoe shop delivering stylish, durable and affordable footwear. Our aim is to provide best quality shoes with excellent customer service.</p>
  </div>
</section><section class="section" id="contact">
  <div class="contact">
    <h3>Contact Us</h3>
    <p><strong>Phone:</strong> +91 XXXXX XXXXX</p>
    <p><strong>WhatsApp:</strong> +91 XXXXX XXXXX</p>
    <p><strong>Address:</strong> Karimpur, Punjab, India</p>
  </div>
</section><footer>
  <p>© 2026 YoSidhu Shoes. All Rights Reserved.</p>
</footer></body>
</html>
